<%{
	// new code
	return_list = input.result;
	totalReq = 0;
	completedCount = 0;
	canceledCount = 0;
	pendingCount = 0;
	if(!input.return_list.isEmpty())
	{
		// ── Counts derived from the SEARCH RESULT set (from the maps, no re-query) ──
		for each  resrec in return_list.toList()
		{
			recStatus = ifnull(resrec.get("status"),"");
			totalReq = totalReq + 1;
			if(recStatus == "Completed" || recStatus == "Mobilization Completed" || recStatus == "Issued")
			{
				completedCount = completedCount + 1;
			}
			else if(recStatus == "Request Canceled")
			{
				canceledCount = canceledCount + 1;
			}
			else
			{
				pendingCount = pendingCount + 1;
			}
		}
	}
	else
	{
		// ── Full register (no search active) ──
		totalReq = LogiRequest[ID != 0].count();
		completedCount = LogiRequest[ID != 0 && Status == "Completed" || Status == "Mobilization Completed" || Status == "Issued"].count();
		canceledCount = LogiRequest[ID != 0 && Status == "Request Canceled"].count();
		pendingCount = LogiRequest[ID != 0 && Status != "Completed" && Status != "Mobilization Completed" && Status != "Request Canceled" && Status != "Issued"].count();
	}
	// ── BUILD THE TABLE LIST ──
	LogiRequestList = List();
	if(!input.return_list.isEmpty())
	{
		for each  resrec in return_list.toList()
		{
			LogiRequestList.add(resrec);
		}
	}
	else
	{
		for each  val in LogiRequest[ID != 0 && Status != "Request Canceled"] sort by Request desc
		{
			LogiRequestList.add(val.ID);
		}
	}
	bannerHTML = "";
	searchTxt = ifnull(input.searchRec,"all");
	clean = searchTxt.replaceAll("_"," ");
	searchTerm = searchTxt.replaceAll("\"","");
	tableHTML = "";
	bannerHTML = "<div style='display:flex;align-items:center;gap:12px;background:#F1EFE8;border-left:4px solid #B4B2A9;border-radius:0 8px 8px 0;padding:12px 16px;margin-bottom:12px;font-family:sans-serif;'>";
	bannerHTML = bannerHTML + "<span style='color:#5F5E5A;font-size:14px;'>Showing <b> [ " + clean.toUpperCase() + " ] [ " + totalReq + " ] requests</b></span>";
	bannerHTML = bannerHTML + "</div>";
	finalHTML = bannerHTML + tableHTML;
	%>
<div style="font-family:Arial, sans-serif; background-color:#f5f7fa; padding:20px;">
	<div style="display:flex;flex-direction:coloumn;justify-content:space-around;">
	<h2 style="margin-bottom:15px;color:#4834d4">
        Total No Of Request - <%=totalReq%>
    </h2>
	<h2 style="color:#badc58">Completed ( <%=completedCount%>)</h2>
	<h2 style="color:#f0932b">Canceled ( <%=canceledCount%>)</h2>
	<h2 style="color:#ff7979">Pending Request ( <%=pendingCount%> ) </h2>
	</div>
	<div style="
	max-height:100vh;
	overflow-y:auto;
	overflow-x:auto;
	border:1px solid #ddd;
">
	<table style="width:100%; border-collapse:collapse;">
            <thead>
			<tr>
			<th colspan="7" style="padding:0; background:#fff;position:sticky; top:0;z-index:3"><%=finalHTML%></th>
			</tr>
			<tr>
				<th style="position:sticky; top:50px;z-index:2; background:#2f4050; color:#fff; padding:12px;text-align:left;">LogiRequest #</th>
				<th style="position:sticky; top:50px;z-index:2; background:#2f4050; color:#fff; padding:12px;text-align:left;">Requested Date</th>
				<th style="position:sticky; top:50px;z-index:2; background:#2f4050; color:#fff; padding:12px;text-align:left;">Request Type</th>
				<th style="position:sticky; top:50px;z-index:2; background:#2f4050; color:#fff; padding:12px;text-align:left;">Requested By</th>
				<th style="position:sticky; top:50px;z-index:2; background:#2f4050; color:#fff; padding:12px;text-align:left;">Requested From</th>
				<th style="position:sticky; top:50px;z-index:2; background:#2f4050; color:#fff; padding:12px;text-align:left;">Status</th>
				<th style="position:sticky; top:50px;z-index:2; background:#2f4050; color:#fff; padding:12px;text-align:left;width:20%">Holding Reason</th>
               </tr>
            </thead>
			<tbody>
<%
	if(LogiRequestList != null)
	{
		for each  ftLogReq in LogiRequestList
		{
			// ftLogReq is an ID → fetch the actual record
			if(ftLogReq.contains("id"))
			{
				lgID = LogiRequest[ID == ftLogReq.get("id").toLong()];
			}
			else
			{
				lgID = LogiRequest[ID == ftLogReq.toLong()];
			}
			requesterLocation = Warehouse[ID == lgID.Location_of_Requester].Warehouse_Name;
			user = "";
			if(lgID.Requester_Name != null)
			{
				user = Employee_Master[ID == lgID.Requester_Name].Employee_Name;
			}
			statusStyle = "padding:4px 10px; border-radius:12px; font-size:12px; font-weight:bold; display:inline-block;";
			if(lgID.Mobilize_from_Store == true)
			{
				requestMode = "Store Inventory Mobilization";
			}
			else if(lgID.Vendor_Purchase_Required == true)
			{
				requestMode = "Vendor Procurement";
			}
			else if(lgID.Credit_purchase == true)
			{
				requestMode = "Credit Purchase";
			}
			else if(lgID.Cash_purchase_PC_Card == true)
			{
				requestMode = "Cash / Procurement Card Purchase";
			}
			else if(lgID.Direct_Issue_Voucher == true)
			{
				requestMode = "Direct Issue Voucher";
			}
			else if(lgID.Mobilized_from_Vendor == true)
			{
				requestMode = "Vendor Mobilization (Direct Issue Voucher)";
			}
			else
			{
				requestMode = "---";
			}
			statusKey = lgID.Status;
			// ── One message per status ──
			msgMap = Map();
			msgMap.put("Pending","LGR Initiated, Awaiting Line Manager Approval");
			msgMap.put("Project In-Charge Approved","Line Manager Approved, Awaiting Logistics verification");
			msgMap.put("Logistics Representative Approved","Logistics Verified, Awaiting next approval step");
			msgMap.put("Quotation Send","BSCR Uploaded quotations, Awaiting Logistics to add Notes");
			msgMap.put("PO Notes Added","Logistics added Notes, Awaiting GM Quotation Approval");
			msgMap.put("GM Approved","GM Approved, Awaiting next step");
			msgMap.put("Quotation Approved","GM Quotation Approved, Awaiting BSCR to Draft PO.");
			msgMap.put("Initiated PO","BSCR Drafted PO, Awaiting GM to Review & Approve PO");
			msgMap.put("PO Approved By GM","GM Approved PO, Awaiting CFA/A&F Manager PO approval in (FG)");
			msgMap.put("PO Approved","GM/CEO PO Approved in BOOKS, Awaiting Finance Dept to Initiate payment");
			msgMap.put("Credit PO Approved","CEO payment Approved, Awaiting BSCR to Email Vendor");
			msgMap.put("Payment Approved by CEO","CEO Payment Approved, Awaiting next step");
			msgMap.put("Payment Requested","Finance Dept Initiated payment, Awaiting CEO Approval");
			msgMap.put("Initiated – Additional Payment Request","Awaiting GM Approval");
			msgMap.put("GM Approved – Proceed to Procurement","Approved by GM. Awaiting Requester to Create a Bills / Expense");
			msgMap.put("Request Cash Withdrawal","Requester Requested Cash Withdrawal, Awaiting GM Approval");
			msgMap.put("GM Approved - Cash Withdrawal","GM Approved Cash Withdrawal, Awaiting Requester to Generate Bill / Expense");
			msgMap.put("Cash Withdrawal Rejected by GM","GM Rejected Cash Withdrawal, Awaiting Requester to Re-Initiate Request");
			msgMap.put("Payment Request Skipped by Finance","Payment skipped by Finance. Awaiting Requester to create the bill or expense.");
			msgMap.put("Expense / Bill Partially Created","Bill or expense partially created. Awaiting Requester to Complete the Request");
			msgMap.put("Expense / Bill Created","Bill/expense created. Awaiting CF/AFM to Approve the Transactions in (FG)");
			msgMap.put("Email Sent to Vendor","BSCR Emailed PO to Vendor, Awaiting SK/LG/BSCR/FD to Upload Bill & Delivery Note.");
			msgMap.put("Vendor Email Ignored","BSCR Ignored PO Email, Awaiting SK/LG/BSCR/FD to Upload Bill & Delivery Note.");
			msgMap.put("Delivery Note & Bill Added","Bill & Delivery Note Uploaded, Awaiting Finance Dept to Convert PO to BILL in (FG)");
			msgMap.put("Mobilization Request","Bill Approved in BOOKS, Awaiting Storekeeper to initiate Mobilization");
			msgMap.put("Mobilized","Storekeeper initiated Mobilization, Awaiting Driver to update Transit");
			msgMap.put("Under Transportation","Under Transit, Awaiting Driver to update the delivery");
			msgMap.put("Delivered","Items Delivered to requester, Awaiting Site Rep/Storekeeper to Receive");
			msgMap.put("Mobilization Completed","Delivered. (Site Rep/Storekeeper Received the delivery)");
			msgMap.put("Completed","Request Completed");
			msgMap.put("Issued","Completed. Items are issued to Site");
			msgMap.put("Request Canceled","Request Canceled");
			msgMap.put("Rejected","Request Rejected");
			// ── Message (raw status as fallback) ──
			status = ifnull(msgMap.get(statusKey),statusKey);
			// ── Color: green = done, red = canceled/rejected, else yellow ──
			statusStyle = "padding:4px 10px; border-radius:12px; font-size:12px; font-weight:bold; display:inline-block;";
			greenSet = {"Mobilization Completed","Completed","Issued"};
			redSet = {"Cash Withdrawal Rejected by GM","Request Canceled","Rejected"};
			if(greenSet.contains(statusKey))
			{
				statusStyle = statusStyle + "background-color:#d4edda; color:#155724;";
			}
			else if(redSet.contains(statusKey))
			{
				statusStyle = statusStyle + "background-color:#FDE2E2; color:#B91C1C;";
			}
			else
			{
				statusStyle = statusStyle + "background-color:#fff3cd; color:#856404;";
			}
			%>
<tr style="border-bottom:1px solid #e0e0e0;">
<tr>
<td style="padding:12px;">
                 <a href="https://creatorapp.zoho.sa/m.alsuhaimi_marasah/fixed-assets/#Report:LogiRequest_Report?ID=<%=lgID.ID%>">
        <%=lgID.Request%>
    </a>
</td>
				<td style="padding:12px;text-align:left;"><%=lgID.Date_Of_Request%></td>
					<td style="padding:12px;text-align:left;"><%=requestMode%></td>
					<td style="padding:12px;text-align:left;"><%=user%></td>
					<td style="padding:12px;text-align:left;"><%=requesterLocation%></td>
					<td style="padding:12px;text-align:left;">
					<span style="<%=statusStyle%>"><%=statusKey%><span/>
					</td>
					<td style="padding:12px;text-align:left;">
<%
			if(!lgID.Holding_Reason.isEmpty())
			{
				%>
<span style="padding:4px 10px; border-radius:12px; font-size:12px; font-weight:bold; display:inline-block; background:#FDE2E2; color:#B91C1C;">
						<%=lgID.Holding_Reason%>
						</span>
<%
			}
			%>
</td>
</tr>
<%
		}
	}
	else
	{
		%>
<tr>
    <td colspan="7" style="padding:40px; text-align:center; color:#888; font-size:15px;">No matching requests found.</td>
</tr>
<%
	}
	%>
</tbody>
</div>
<%

}%>
